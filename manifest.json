{
  "manifest_version": 3,
  "name": "PPS Instatest PoC",
  "version": "1.3.0",
  "description": "Proof of Concept demonstrating AI-powered answer injection for instatest.programmingpathshala.com",
  "permissions": ["activeTab", "storage", "scripting", "offscreen"],
  "host_permissions": [
    "https://instatest.programmingpathshala.com/*",
    "https://backend.programmingpathshala.com/*",
    "https://api.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://instatest.programmingpathshala.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://instatest.programmingpathshala.com/*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}